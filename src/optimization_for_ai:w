import numpy as np


def f(x):
    return (x - 3)**2


def golden_section_search(trpl: np.ndarray, f) -> None:
    if not f(trpl[1]) < f(trpl[0]) and f(trpl[1]) < f(trpl[2]):
        return

    a = trpl[0]
    c = trpl[2]

    phi = (1 + np.sqrt(5)) / 2

    while a < c:
        
        b = (c - a) / phi + a
        d = (a - c) / phi + c

        if f(b) > f(d):
            c = b
        else:
            a = d

    trpl[0] = a
    trpl[2] = c


def main():
    a = np.array([0, 2, 10])
    trpl = np.array([-1, 0.85410197, 2])
    golden_section_search(trpl, f)
    golden_section_search(a, f)

    print(a, f)


if __name__ == "__main__":
    main()
